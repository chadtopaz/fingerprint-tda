# Data (third-party benchmark images and everything derived from them at the pixel level; see Data/README.md).
# Results/Data/... holds only manifests and calibration records and is tracked.
/Data/*
!/Data/README.md

# Run directories and caches (regenerated by the code; never tracked). Anchored at the repository root so that
# Results/Outputs_*/ (the released aggregate files) stays tracked.
/Outputs*/
/Archive*/
**/cache/

# R / RStudio
.Rproj.user/
.Rhistory
.RData
.Ruserdata

# Python
__pycache__/
.venv*/

# OS
.DS_Store
